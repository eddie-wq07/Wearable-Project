package com.example.testwatch.mobile.config

/** Template for ServerConfig.kt (HOST/PORT/USER/PASSWORD/REMOTE_DIR). The real file is gitignored
 *  and never committed — copy this and fill in real values locally. */

object ServerConfig {
    const val HOST = "misr.sauder.ubc.ca"
    const val PORT = 16800
    const val USER = ""              // <-- lab server username
    const val PASSWORD = ""          // <-- temp password until SSH key is provisioned
    const val REMOTE_DIR = "/data1/wearables"   // absolute path on the MISR server (shared, visible to all)

    fun isConfigured(): Boolean = USER.isNotEmpty() && PASSWORD.isNotEmpty()
}
